# ---------------------------------------------------------------------------
# Resend / transactional email
# ---------------------------------------------------------------------------
# Get an API key from https://resend.com/api-keys. Use a sending-only key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The verified sender. The domain must be verified in Resend before mail
# leaves the sandbox (until then, only your own account address can receive).
RESEND_FROM_EMAIL="Samansco Group <enquiries@samansco.com>"

# Optional: force every enquiry notification to one inbox instead of the
# operating-company desk selected in the form. Comma-separated for several.
# ENQUIRY_NOTIFICATION_EMAIL=ops@samansco.com

# Public site URL used for links and footer copy inside emails.
NEXT_PUBLIC_SITE_URL=https://www.samansco.com
